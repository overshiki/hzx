cabal-version:      3.16
name:               hzx
version:            0.1.0.0

author:             overshiki
maintainer:         le.niu@hotmail.com
license:            NONE
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        HZX.Core.Diagram
        HZX.Core.Diagram.Types
        HZX.Core.Diagram.Class
        HZX.Core.Diagram.Instances
        HZX.Core.Phase
        HZX.Core.Scalar
        HZX.Circuit
        HZX.Circuit.ToDiagram
        HZX.Circuit.FromDiagram
        HZX.Circuit.Extraction
        HZX.Circuit.Extraction.Types
        HZX.Circuit.Extraction.Flow
        HZX.Rewrite.Rule
        HZX.Rewrite.Strategy
        HZX.Rewrite.Matcher
        HZX.LinAlg.Z2
        HZX.LatticeSurgery.PauliFrame
        HZX.LatticeSurgery.Heralded
        HZX.LatticeSurgery.Core
        HZX.LatticeSurgery.Protocols.CNOT
        HZX.LatticeSurgery.Protocols.TGate
        HZX.IO.QASM
        HZX.IO.STIM
    build-depends:
        base ^>=4.18.3.0,
        containers ^>=0.6.7,
        parsec ^>=3.1.16,
        megaparsec >=8.0.0 && <10,
        stim-parser ^>=0.2.0.0
    hs-source-dirs:   src
    default-language: Haskell2010

executable hzx
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base ^>=4.18.3.0,
        containers ^>=0.6.7,
        hzx
    hs-source-dirs:   app
    default-language: Haskell2010

test-suite hzx-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:
        Test.Core
        Test.Rewrite
        Test.RoundTrip
        Test.STIM
        Test.BugReport
    build-depends:
        base ^>=4.18.3.0,
        containers ^>=0.6.7,
        hzx,
        tasty ^>=1.4.3,
        tasty-hunit ^>=0.10.1
    hs-source-dirs:   test
    default-language: Haskell2010
